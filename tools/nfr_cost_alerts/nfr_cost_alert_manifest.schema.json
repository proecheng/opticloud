{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story 9.3 NFR-COST red-line alert manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "source_story",
    "alert_version",
    "run_id",
    "example_only",
    "generated_by",
    "commit_sha",
    "cadence_mode",
    "period",
    "redline_evaluations",
    "source_snapshots",
    "prometheus_alerts",
    "dingtalk_payloads",
    "linear_payloads",
    "routing_outcomes",
    "findings",
    "redaction_reviewed",
    "release_approved",
    "real_alert_fired",
    "real_dingtalk_delivered",
    "real_linear_created"
  ],
  "properties": {
    "source_story": {
      "const": "9.3",
      "type": "string"
    },
    "alert_version": {
      "const": "nfr_cost_redline_alerts_v1",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "type": "string"
    },
    "example_only": {
      "type": "boolean"
    },
    "generated_by": {
      "type": "string"
    },
    "commit_sha": {
      "pattern": "^[0-9a-f]{7,40}$",
      "type": "string"
    },
    "cadence_mode": {
      "$ref": "#/$defs/cadenceMode"
    },
    "period": {
      "$ref": "#/$defs/period"
    },
    "redline_evaluations": {
      "items": {
        "$ref": "#/$defs/redlineEvaluation"
      },
      "type": "array"
    },
    "source_snapshots": {
      "items": {
        "$ref": "#/$defs/sourceSnapshot"
      },
      "type": "array"
    },
    "prometheus_alerts": {
      "items": {
        "$ref": "#/$defs/prometheusAlert"
      },
      "type": "array"
    },
    "dingtalk_payloads": {
      "items": {
        "$ref": "#/$defs/dingtalkPayload"
      },
      "type": "array"
    },
    "linear_payloads": {
      "items": {
        "$ref": "#/$defs/linearPayload"
      },
      "type": "array"
    },
    "routing_outcomes": {
      "items": {
        "$ref": "#/$defs/routingOutcome"
      },
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/finding"
      },
      "type": "array"
    },
    "redaction_reviewed": {
      "type": "boolean"
    },
    "release_approved": {
      "type": "boolean"
    },
    "real_alert_fired": {
      "type": "boolean"
    },
    "real_dingtalk_delivered": {
      "type": "boolean"
    },
    "real_linear_created": {
      "type": "boolean"
    }
  },
  "$defs": {
    "cadenceMode": {
      "enum": [
        "quarterly",
        "breach_drill"
      ],
      "type": "string"
    },
    "redlineId": {
      "enum": [
        "llm_revenue_ratio",
        "gpu_idle_rate",
        "provider_share_revenue_ratio",
        "refund_issued_rate",
        "runway_months"
      ],
      "type": "string"
    },
    "evaluationStatus": {
      "enum": [
        "not_run_example",
        "passed",
        "breached",
        "failed",
        "not_applicable"
      ],
      "type": "string"
    },
    "routeStatus": {
      "enum": [
        "not_run_example",
        "payload_ready",
        "failed",
        "not_applicable"
      ],
      "type": "string"
    },
    "period": {
      "additionalProperties": false,
      "properties": {
        "start_date": {
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        "end_date": {
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "type": "object"
    },
    "redlineEvaluation": {
      "additionalProperties": true,
      "properties": {
        "redline_id": {
          "$ref": "#/$defs/redlineId"
        },
        "status": {
          "$ref": "#/$defs/evaluationStatus"
        },
        "threshold": {
          "type": "object"
        },
        "observed_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "window": {
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "redline_id",
        "status",
        "threshold",
        "observed_value",
        "window",
        "finding_ids"
      ],
      "type": "object"
    },
    "sourceSnapshot": {
      "additionalProperties": true,
      "properties": {
        "redline_id": {
          "$ref": "#/$defs/redlineId"
        },
        "signal_id": {
          "type": "string"
        },
        "source_system": {
          "type": "string"
        },
        "metric_name": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/evaluationStatus"
        },
        "artifact_path": {
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "redline_id",
        "signal_id",
        "source_system",
        "metric_name",
        "status",
        "artifact_path",
        "finding_ids"
      ],
      "type": "object"
    },
    "prometheusAlert": {
      "additionalProperties": true,
      "properties": {
        "redline_id": {
          "$ref": "#/$defs/redlineId"
        },
        "alert_name": {
          "type": "string"
        },
        "promql_ref": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/evaluationStatus"
        },
        "artifact_path": {
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "redline_id",
        "alert_name",
        "promql_ref",
        "status",
        "artifact_path",
        "finding_ids"
      ],
      "type": "object"
    },
    "dingtalkPayload": {
      "additionalProperties": true,
      "properties": {
        "redline_id": {
          "$ref": "#/$defs/redlineId"
        },
        "status": {
          "$ref": "#/$defs/routeStatus"
        },
        "severity": {
          "type": "string"
        },
        "markdown_title": {
          "type": "string"
        },
        "markdown_text": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "runbook_path": {
          "type": "string"
        },
        "evidence_pointer": {
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "redline_id",
        "status",
        "severity",
        "markdown_title",
        "markdown_text",
        "summary",
        "runbook_path",
        "evidence_pointer",
        "finding_ids"
      ],
      "type": "object"
    },
    "linearPayload": {
      "additionalProperties": true,
      "properties": {
        "redline_id": {
          "$ref": "#/$defs/redlineId"
        },
        "status": {
          "$ref": "#/$defs/routeStatus"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "team_key": {
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "severity": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "due_date": {
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        "evidence_pointer": {
          "type": "string"
        },
        "external_issue_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "redline_id",
        "status",
        "title",
        "description",
        "team_key",
        "labels",
        "severity",
        "owner",
        "due_date",
        "evidence_pointer",
        "external_issue_id",
        "finding_ids"
      ],
      "type": "object"
    },
    "routingOutcome": {
      "additionalProperties": true,
      "properties": {
        "redline_id": {
          "$ref": "#/$defs/redlineId"
        },
        "dingtalk_status": {
          "$ref": "#/$defs/routeStatus"
        },
        "linear_status": {
          "$ref": "#/$defs/routeStatus"
        },
        "owner_ack_status": {
          "enum": [
            "not_run_example",
            "pending",
            "acked",
            "failed"
          ],
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "redline_id",
        "dingtalk_status",
        "linear_status",
        "owner_ack_status",
        "finding_ids"
      ],
      "type": "object"
    },
    "finding": {
      "additionalProperties": true,
      "properties": {
        "finding_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        "source": {
          "enum": [
            "redline_evaluation",
            "source_snapshot",
            "prometheus_alert",
            "dingtalk_payload",
            "linear_payload",
            "routing_outcome"
          ],
          "type": "string"
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ],
          "type": "string"
        },
        "status": {
          "enum": [
            "open",
            "in_progress",
            "resolved",
            "deferred"
          ],
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "ticket_refs": {
          "items": {
            "$ref": "#/$defs/ticketRef"
          },
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "source",
        "severity",
        "status",
        "summary",
        "ticket_refs"
      ],
      "type": "object"
    },
    "ticketRef": {
      "additionalProperties": false,
      "properties": {
        "ticket_id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ],
          "type": "string"
        },
        "due_date": {
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        "status": {
          "enum": [
            "open",
            "in_progress",
            "resolved",
            "deferred"
          ],
          "type": "string"
        }
      },
      "required": [
        "ticket_id",
        "owner",
        "severity",
        "due_date",
        "status"
      ],
      "type": "object"
    }
  }
}
