  "redline_catalog": [
    {
      "redline_id": "llm_revenue_ratio",
      "name": "LLM cost to revenue ratio",
      "owner": "NFR-COST",
      "severity": "P1",
      "threshold": {
        "comparator": ">=",
        "value": 0.3,
        "unit": "ratio"
      },
      "prometheus_alert": {
        "alert_name": "OptiCloudNfrCostLlmRevenueRatioHigh",
        "promql": "sum(rate(opticloud_llm_cost_cny_total[30d])) / clamp_min(sum(rate(opticloud_revenue_cny_total[30d])), 1) >= 0.30",
        "for": "30m",
        "labels": {
          "severity": "P1",
          "nfr": "NFR-COST",
          "redline_id": "llm_revenue_ratio",
          "owner": "nfr-cost"
        },
        "annotations": {
          "summary": "LLM cost exceeds 30 percent of revenue",
          "runbook": "docs/runbooks/nfr-cost-alerts.md",
          "evidence": "reports/nfr-cost-alerts/<run_id>/alert_manifest.json"
        }
      },
      "input_signals": [
        {
          "signal_id": "llm_cost_cny",
          "source_system": "future chat or LLM provider cost telemetry",
          "expected_metric_name": "opticloud_llm_cost_cny_total",
          "unit": "cny",
          "aggregation_window": "30d",
          "implementation_state": "planned"
        },
        {
          "signal_id": "revenue_cny",
          "source_system": "billing revenue aggregation",
          "expected_metric_name": "opticloud_revenue_cny_total",
          "unit": "cny",
          "aggregation_window": "30d",
          "implementation_state": "planned"
        }
      ]
    },
