{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story 9.1 quarterly accessibility audit manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "source_story",
    "audit_version",
    "run_id",
    "example_only",
    "generated_by",
    "commit_sha",
    "quarter",
    "period",
    "automated_axe",
    "manual_sampling",
    "findings",
    "redaction_reviewed",
    "release_approved",
    "real_panel_completed",
    "third_party_audit_completed"
  ],
  "properties": {
    "source_story": {
      "const": "9.1",
      "type": "string"
    },
    "audit_version": {
      "const": "quarterly_a11y_audit_v1",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "type": "string"
    },
    "example_only": {
      "type": "boolean"
    },
    "generated_by": {
      "type": "string"
    },
    "commit_sha": {
      "pattern": "^[0-9a-f]{7,40}$",
      "type": "string"
    },
    "quarter": {
      "pattern": "^20[0-9]{2}-Q[1-4]$",
      "type": "string"
    },
    "period": {
      "$ref": "#/$defs/period"
    },
    "automated_axe": {
      "$ref": "#/$defs/automatedAxe"
    },
    "manual_sampling": {
      "$ref": "#/$defs/manualSampling"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/finding"
      },
      "type": "array"
    },
    "redaction_reviewed": {
      "type": "boolean"
    },
    "release_approved": {
      "type": "boolean"
    },
    "real_panel_completed": {
      "type": "boolean"
    },
    "third_party_audit_completed": {
      "type": "boolean"
    }
  },
  "$defs": {
    "profileId": {
      "enum": [
        "screen_reader",
        "keyboard_only",
        "high_contrast",
        "low_vision",
        "motor",
        "cognitive"
      ],
      "type": "string"
    },
    "personaId": {
      "enum": [
        "li_gong_curl",
        "lina_csv",
        "lao_zhang_excel",
        "chen_architect_sdk"
      ],
      "type": "string"
    },
    "period": {
      "additionalProperties": false,
      "properties": {
        "start_date": {
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        "end_date": {
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "type": "object"
    },
    "automatedAxe": {
      "additionalProperties": true,
      "properties": {
        "package": {
          "const": "@opticloud/ui",
          "type": "string"
        },
        "command": {
          "const": "pnpm --filter @opticloud/ui test:a11y",
          "type": "string"
        },
        "executed": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "not_run_example",
            "passed",
            "failed"
          ],
          "type": "string"
        },
        "violation_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "test_files": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "package",
        "command",
        "executed",
        "status",
        "violation_count",
        "test_files",
        "finding_ids"
      ],
      "type": "object"
    },
    "manualSampling": {
      "additionalProperties": true,
      "properties": {
        "matrix": {
          "items": {
            "$ref": "#/$defs/manualSamplingCell"
          },
          "type": "array"
        }
      },
      "required": [
        "matrix"
      ],
      "type": "object"
    },
    "manualSamplingCell": {
      "additionalProperties": true,
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/profileId"
        },
        "persona_id": {
          "$ref": "#/$defs/personaId"
        },
        "status": {
          "enum": [
            "not_run_example",
            "passed",
            "failed",
            "skipped_with_reason"
          ],
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "persona_id",
        "status",
        "finding_ids",
        "notes"
      ],
      "type": "object"
    },
    "finding": {
      "additionalProperties": true,
      "properties": {
        "finding_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        "source": {
          "enum": [
            "automated_axe",
            "manual_sampling"
          ],
          "type": "string"
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ],
          "type": "string"
        },
        "status": {
          "enum": [
            "open",
            "in_progress",
            "resolved",
            "deferred"
          ],
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "ticket_refs": {
          "items": {
            "$ref": "#/$defs/ticketRef"
          },
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "source",
        "severity",
        "status",
        "summary",
        "ticket_refs"
      ],
      "type": "object"
    },
    "ticketRef": {
      "additionalProperties": false,
      "properties": {
        "ticket_id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ],
          "type": "string"
        },
        "due_date": {
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        "status": {
          "enum": [
            "open",
            "in_progress",
            "resolved",
            "deferred"
          ],
          "type": "string"
        }
      },
      "required": [
        "ticket_id",
        "owner",
        "severity",
        "due_date",
        "status"
      ],
      "type": "object"
    }
  }
}
